{
  "name": "talk-me-out-of-it-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Replay UI for the Talk Me Out of It council. Reads saved session transcripts and plays them back. Builds to static files for Cloudflare Pages.",
  "scripts": {
    "sync": "node scripts/sync-gallery.mjs",
    "predev": "node scripts/sync-gallery.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-gallery.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postbuild": "node scripts/write-previews.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev --port 8788 --ip 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
